{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveCaption",
  "version": "0.5.0",
  "identifier": "com.dimfi.livecaption",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src-tauri\\worker\\before-tauri-build.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "LiveCaption",
        "width": 980,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "LiveCaption Overlay",
        "url": "index.html",
        "width": 760,
        "height": 170,
        "x": 360,
        "y": 120,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "resizable": true
      },
      {
        "label": "selection-toolbar",
        "title": "LiveCaption Toolbar",
        "url": "index.html",
        "width": 246,
        "height": 44,
        "shadow": false,
        "focus": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "resizable": false
      },
      {
        "label": "ocr-capture",
        "title": "框选截图",
        "url": "index.html",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false
      },
      {
        "label": "ocr-result",
        "title": "截图翻译",
        "url": "index.html",
        "width": 520,
        "height": 340,
        "minWidth": 400,
        "minHeight": 280,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "transparent": true,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "worker/dist/livecaption-asr-worker": "asr-worker",
      "ocr-worker/dist/livecaption-ocr-worker": "ocr-worker"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      }
    }
  }
}
